Copyright (c) 2026 Jan Philipp Harries. All rights reserved.

Group-2 isosceles target (row I; Lemma `lem:rowI`(a) of no19tiling.tex;
progress634 Table `tab:group2` row I, Theorem `thm:laurent`, Corollary `cor:rows`,
Appendix `app:rowalgebra`), and the equilateral target (row E) by the same quotient.

Tile: primitive `(a, b, c)` with `c^2 = a^2 + ab + b^2` (`G2Triple`). Target `(α, α, π - 2α)`
with sides `k (c, c, a+2b)` and count `N * b = k^2 (a + 2b)`.

Formalized:
* (i)   `b ≥ 2` (and `a ≥ 2`) for every positive solution of `c^2 = a^2 + ab + b^2`;
* the row-I side vector `(c, c, a+2b)` is primitive, so a positive rational scale is an integer;
* (ii)  `b ∣ k` makes `N = (k/b)^2 · b · (a+2b)` composite;
* (iii) the algebraic core of the boundary-character argument, in the Laurent polynomial
        ring `ℤ[T;T⁻¹]` (Mathlib's `LaurentPolynomial ℤ`, variable `T 1 = z`):
        `I = (d + c z, d + c z⁻¹)` with `d = a - b` contains `3ab`; `c` and `d` are units mod
        `3ab`; the ring map `ε : ℤ[z, z⁻¹] → ZMod (3ab)`, `z ↦ -d c⁻¹`, kills `I`; and
        `ε(k (U - c z⁻¹ - c z)) = 0 ↔ b ∣ k`.
* Row E: `ε(± 3L z^e) = 0 ↔ ab ∣ L`, so `N * ab = L^2` gives a composite `N`.

The formalized row-I target boundary polynomial is exactly
  `B_I(k) = k · (U - c z⁻¹ - c z)`,   `U = a + 2b`
(no19tiling.tex, proof of Lemma `lem:rowI`(a); progress634 App. `app:rowalgebra`,
row I, `B = k(U - cz - cz⁻¹)`), up to the unit factor `χ(θ₀)`, which does not affect ideal
membership.

NOT formalized (geometric premise): that `B_I(k) ∈ I`. It is the content of the boundary
character lemma (`lem:character`) and enters as the hypothesis `RowIPremise`.
-/
import No19Tiling.Group2
import Mathlib.Algebra.Polynomial.Laurent
import Mathlib.RingTheory.Coprime.Lemmas
import Mathlib.RingTheory.Ideal.Span

open LaurentPolynomial

namespace No19Tiling

/-- (i) `b = 1` is impossible: `c^2 = a^2 + a + 1` lies strictly between `a^2` and `(a+1)^2`. -/
theorem norm_b_ne_one {a c : ℕ} (ha : 0 < a) : c ^ 2 ≠ a ^ 2 + a * 1 + 1 ^ 2 := by
  intro h
  have h1 : a < c := by
    by_contra hc; push Not at hc
    have : c ^ 2 ≤ a ^ 2 := Nat.pow_le_pow_left hc 2
    omega
  have h2 : c < a + 1 := by
    by_contra hc; push Not at hc
    have : (a + 1) ^ 2 ≤ c ^ 2 := Nat.pow_le_pow_left hc 2
    nlinarith
  omega

namespace G2Triple

variable (t : G2Triple)

/-- (i) `b ≥ 2` for every primitive Group-2 triple. -/
theorem two_le_b : 2 ≤ t.b := by
  have hb := t.hb
  by_contra h
  have h1 : t.b = 1 := by omega
  have := t.norm
  rw [h1] at this
  exact norm_b_ne_one t.ha this

/-- `a ≥ 2` (the swapped statement). -/
theorem two_le_a : 2 ≤ t.a := t.swap.two_le_b

/-- `gcd(c, a + 2b) = 1`. -/
theorem coprime_c_U : Nat.Coprime t.c (t.a + 2 * t.b) := by
  apply Nat.coprime_of_dvd
  intro q hq hc hU
  -- c^2 + 3b(a+b) = (a+2b)^2
  have e : t.c ^ 2 + 3 * t.b * (t.a + t.b) = (t.a + 2 * t.b) ^ 2 := by rw [t.norm]; ring
  have h1 : q ∣ 3 * t.b * (t.a + t.b) := by
    have h := dvd_pow hU two_ne_zero
    rw [← e] at h
    exact (Nat.dvd_add_right (dvd_pow hc two_ne_zero)).mp h
  rcases (Nat.Prime.dvd_mul hq).mp h1 with h2 | h2
  · rcases (Nat.Prime.dvd_mul hq).mp h2 with h3 | h3
    · have : q = 3 := (Nat.prime_dvd_prime_iff_eq hq Nat.prime_three).mp h3
      subst this
      exact t.not_three_dvd_c hc
    · exact not_dvd_both_of_coprime hq t.coprime_bc h3 hc
  · -- q ∣ a + b and q ∣ a + 2b give q ∣ b
    have hb : q ∣ t.b := by
      have e2 : t.a + 2 * t.b = (t.a + t.b) + t.b := by ring
      rw [e2] at hU
      exact (Nat.dvd_add_right h2).mp hU
    exact not_dvd_both_of_coprime hq t.coprime_bc hb hc

/-- The row-I side vector `(c, c, a+2b)` is primitive. -/
theorem rowI_primitive : Primitive3 t.c t.c (t.a + 2 * t.b) := by
  unfold Primitive3; rw [Nat.gcd_self]; exact t.coprime_c_U

/-- (ii) If `b ∣ k` and `N * b = k^2 (a + 2b)`, then `N = (k/b)^2 · b · (a+2b)` is not prime. -/
theorem rowI_not_prime_of_dvd {k N : ℕ} (hk : t.b ∣ k) (hN : N * t.b = k ^ 2 * (t.a + 2 * t.b)) :
    ¬ N.Prime := by
  obtain ⟨m, rfl⟩ := hk
  have hb := t.hb
  have hN' : N = t.b * m ^ 2 * (t.a + 2 * t.b) := by
    apply Nat.eq_of_mul_eq_mul_right hb
    rw [hN]; ring
  intro hp
  rw [hN'] at hp
  rcases Nat.eq_zero_or_pos m with h0 | h0
  · rw [h0] at hp; simp at hp; exact Nat.not_prime_zero hp
  · have : 1 ≤ m ^ 2 := Nat.one_le_pow _ _ h0
    have hb2 := t.two_le_b
    exact Nat.not_prime_mul (by nlinarith) (by omega) hp

/-! ## The Laurent boundary quotient (algebraic core) -/

/-- `d = a - b` (in `ℤ`). -/
def d : ℤ := (t.a : ℤ) - t.b

/-- The modulus `3ab`. -/
def n : ℕ := 3 * t.a * t.b

/-- The ideal `I = (d + c z, d + c z⁻¹)` of `ℤ[z, z⁻¹]`, generated by the boundary values of a
reflected and of a direct tile (no19tiling.tex, proof of Lemma `lem:rowI`, "Tile values"). -/
noncomputable def ideal : Ideal ℤ[T;T⁻¹] :=
  Ideal.span {C t.d + C (t.c : ℤ) * T 1, C t.d + C (t.c : ℤ) * T (-1)}

theorem d_sq : t.d ^ 2 = (t.c : ℤ) ^ 2 - 3 * t.a * t.b := by
  have h : (t.c : ℤ) ^ 2 = (t.a : ℤ) ^ 2 + t.a * t.b + t.b ^ 2 := by exact_mod_cast t.norm
  unfold d; rw [h]; ring

/-- `3ab ∈ I`, from `c (d + c z) z⁻¹ - d (d + c z⁻¹) = c^2 - d^2 = 3ab`. -/
theorem three_ab_mem : C ((t.n : ℕ) : ℤ) ∈ t.ideal := by
  have e : C ((t.n : ℕ) : ℤ) = (C (t.c : ℤ) * T (-1)) * (C t.d + C (t.c : ℤ) * T 1)
      - C t.d * (C t.d + C (t.c : ℤ) * T (-1)) := by
    have hT : (T (-1) : ℤ[T;T⁻¹]) * T 1 = 1 := by rw [← T_add]; simp
    have hn : ((t.n : ℕ) : ℤ) = (t.c : ℤ) ^ 2 - t.d ^ 2 := by
      rw [t.d_sq]; unfold n; push_cast; ring
    rw [hn]
    simp only [map_sub, map_pow]
    linear_combination (-(C (t.c : ℤ)) ^ 2) * hT
  rw [e]
  apply Ideal.sub_mem
  · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
  · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))

/-- A residue of an integer coprime to `n` is a unit of `ZMod n`. -/
theorem isUnit_of_isCoprime {x : ℤ} {m : ℕ} (h : IsCoprime x (m : ℤ)) : IsUnit (x : ZMod m) := by
  obtain ⟨u, v, huv⟩ := h
  apply IsUnit.of_mul_eq_one (u : ZMod m)
  have := congrArg (fun z : ℤ => (z : ZMod m)) huv
  simp only [Int.cast_add, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, mul_zero,
    add_zero, Int.cast_one] at this
  rw [mul_comm]; exact this

/-- `3 ∤ d = a - b`, since `d^2 ≡ c^2 (mod 3)` and `3 ∤ c`. -/
theorem not_three_dvd_d : ¬ (3 : ℤ) ∣ t.d := by
  intro h
  apply t.not_three_dvd_c
  have h2 : (3 : ℤ) ∣ (t.c : ℤ) ^ 2 := by
    have : (t.c : ℤ) ^ 2 = t.d ^ 2 + 3 * (t.a * t.b) := by rw [t.d_sq]; ring
    rw [this]
    exact dvd_add (dvd_pow h two_ne_zero) (dvd_mul_right _ _)
  have h3 : (3 : ℤ) ∣ t.c := Int.prime_three.dvd_of_dvd_pow h2
  exact_mod_cast h3

/-- Remark: `3 ∤ a + b` is *not* true for Group-2 triples (it holds for the `60°` triples of
progress634 Lemma `lem:g60-units`): `(7, 8, 13)` is primitive with `3 ∣ 7 + 8`. The unit needed
for `ε` is `d = a - b`, and `3 ∤ a - b` is `not_three_dvd_d`. -/
theorem exists_three_dvd_a_add_b : ∃ t : G2Triple, 3 ∣ t.a + t.b :=
  ⟨⟨7, 8, 13, by norm_num, by norm_num, by norm_num, by decide⟩, ⟨5, by norm_num⟩⟩

/-- `c` is coprime to `3ab` (pairwise coprimality and `3 ∤ c`). -/
theorem isCoprime_c : IsCoprime (t.c : ℤ) ((t.n : ℕ) : ℤ) := by
  rw [Nat.isCoprime_iff_coprime]
  have h3 : Nat.Coprime t.c 3 :=
    ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr t.not_three_dvd_c).symm
  exact Nat.Coprime.mul_right (Nat.Coprime.mul_right h3 t.coprime_ac.symm) t.coprime_bc.symm

/-- `d = a - b` is coprime to `3ab` (pairwise coprimality and `3 ∤ a - b`). -/
theorem isCoprime_d : IsCoprime t.d ((t.n : ℕ) : ℤ) := by
  have hab : IsCoprime (t.a : ℤ) (t.b : ℤ) := Nat.isCoprime_iff_coprime.mpr t.coprime_ab
  have hda : IsCoprime t.d (t.a : ℤ) := by
    have := (hab.symm.neg_left).add_mul_left_left 1
    unfold d; convert this using 1; ring
  have hdb : IsCoprime t.d (t.b : ℤ) := by
    have := hab.add_mul_left_left (-1)
    unfold d; convert this using 1; ring
  have hd3 : IsCoprime t.d (3 : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one]
    have h := Int.gcd_dvd_right t.d 3
    have hle : Int.gcd t.d 3 ∣ 3 := by exact_mod_cast h
    rcases (Nat.dvd_prime Nat.prime_three).mp hle with h1 | h1
    · exact h1
    · exfalso; apply t.not_three_dvd_d
      have := Int.gcd_dvd_left t.d 3
      rw [h1] at this; exact_mod_cast this
  unfold n; push_cast
  exact (hd3.mul_right hda).mul_right hdb

/-- `c` as a unit of `ZMod (3ab)`. -/
noncomputable def cU : (ZMod t.n)ˣ := (isUnit_of_isCoprime t.isCoprime_c).unit

/-- `d` as a unit of `ZMod (3ab)`. -/
noncomputable def dU : (ZMod t.n)ˣ := (isUnit_of_isCoprime t.isCoprime_d).unit

theorem cU_val : (t.cU : ZMod t.n) = (t.c : ZMod t.n) := by
  simp [cU]

theorem dU_val : (t.dU : ZMod t.n) = (t.d : ZMod t.n) := by
  simp [dU]

/-- The evaluation point `w = -d c⁻¹`, a unit of `ZMod (3ab)`. -/
noncomputable def w : (ZMod t.n)ˣ := -(t.dU * t.cU⁻¹)

/-- The ring map `ε : ℤ[z, z⁻¹] → ZMod (3ab)`, `z ↦ -d c⁻¹`. -/
noncomputable def eps : ℤ[T;T⁻¹] →+* ZMod t.n := eval₂ (Int.castRingHom (ZMod t.n)) t.w

theorem c_mul_cinv : (t.c : ZMod t.n) * ((t.cU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n) = 1 := by
  rw [← t.cU_val, Units.mul_inv]

theorem d_mul_dinv : (t.d : ZMod t.n) * ((t.dU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n) = 1 := by
  rw [← t.dU_val, Units.mul_inv]

theorem w_val : (t.w : ZMod t.n) = -((t.d : ZMod t.n) * ((t.cU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n)) := by
  simp [w, t.dU_val]

theorem winv_val :
    ((t.w⁻¹ : (ZMod t.n)ˣ) : ZMod t.n) = -((t.c : ZMod t.n) * ((t.dU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n)) := by
  set x := -((t.c : ZMod t.n) * ((t.dU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n))
  have hx : x * (t.w : ZMod t.n) = 1 := by
    rw [t.w_val]
    calc x * -((t.d : ZMod t.n) * ((t.cU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n))
        = ((t.c : ZMod t.n) * ((t.cU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n))
          * ((t.d : ZMod t.n) * ((t.dU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n)) := by ring
      _ = 1 := by rw [t.c_mul_cinv, t.d_mul_dinv, one_mul]
  calc ((t.w⁻¹ : (ZMod t.n)ˣ) : ZMod t.n)
      = (x * (t.w : ZMod t.n)) * ((t.w⁻¹ : (ZMod t.n)ˣ) : ZMod t.n) := by rw [hx, one_mul]
    _ = x := by rw [mul_assoc, Units.mul_inv, mul_one]

theorem eps_C (r : ℤ) : t.eps (C r) = (r : ZMod t.n) := by
  simp [eps]

theorem eps_T_one : t.eps (T 1) = (t.w : ZMod t.n) := by
  simp [eps]

theorem eps_T_neg_one : t.eps (T (-1)) = ((t.w⁻¹ : (ZMod t.n)ˣ) : ZMod t.n) := by
  simp [eps]

theorem n_eq_zero : ((t.n : ℕ) : ZMod t.n) = 0 := ZMod.natCast_self _

/-- `ε` kills the ideal `I`: `ε(d + cz) = d - c d c⁻¹ = 0` and
`ε(d + cz⁻¹) = d - c^2 d⁻¹ = d⁻¹ (d^2 - c^2) = -3ab d⁻¹ = 0`. -/
theorem eps_kills_ideal : t.ideal ≤ RingHom.ker t.eps := by
  unfold ideal
  rw [Ideal.span_le]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  simp only [SetLike.mem_coe, RingHom.mem_ker]
  rcases hx with rfl | rfl
  · rw [map_add, map_mul, t.eps_C, t.eps_C, t.eps_T_one, t.w_val]
    have := t.c_mul_cinv
    push_cast
    linear_combination (-(t.d : ZMod t.n)) * this
  · rw [map_add, map_mul, t.eps_C, t.eps_C, t.eps_T_neg_one, t.winv_val]
    have h1 := t.d_mul_dinv
    have h2 : (t.d : ZMod t.n) ^ 2 - (t.c : ZMod t.n) ^ 2 = -((t.n : ℕ) : ZMod t.n) := by
      have : (t.d) ^ 2 - (t.c : ℤ) ^ 2 = -((t.n : ℕ) : ℤ) := by
        rw [t.d_sq]; unfold n; push_cast; ring
      have h := congrArg (fun z : ℤ => (z : ZMod t.n)) this
      push_cast at h
      exact h
    rw [t.n_eq_zero, neg_zero] at h2
    push_cast
    linear_combination ((t.dU⁻¹ : (ZMod t.n)ˣ) : ZMod t.n) * h2 - (t.d : ZMod t.n) * h1

/-! ### Row I -/

/-- The row-I target boundary polynomial `B_I(k) = k (U - c z⁻¹ - c z)`, `U = a + 2b`. -/
noncomputable def rowIBoundary (k : ℤ) : ℤ[T;T⁻¹] :=
  C k * (C ((t.a : ℤ) + 2 * t.b) - C (t.c : ℤ) * T (-1) - C (t.c : ℤ) * T 1)

/-- **Geometric premise (not formalized).** The row-I target boundary value lies in `I`.
This is what Lemma `lem:character` gives for a tiling of the target
`(α, α, π - 2α)` with sides `k (c, c, a + 2b)`: the target boundary is the sum of the tile
boundaries, each a Laurent unit times `d + c z⁻¹` or `d + c z`. -/
def RowIPremise (k : ℕ) : Prop := t.rowIBoundary k ∈ t.ideal

/-- The evaluation identity `d · ε(U - c z⁻¹ - c z) = dU + c^2 + d^2 = 3 a^2` in `ZMod (3ab)`. -/
theorem d_mul_eps_rowI :
    (t.d : ZMod t.n) * t.eps (C ((t.a : ℤ) + 2 * t.b) - C (t.c : ℤ) * T (-1) - C (t.c : ℤ) * T 1)
      = 3 * (t.a : ZMod t.n) ^ 2 := by
  rw [map_sub, map_sub, map_mul, map_mul, t.eps_C, t.eps_C, t.eps_T_neg_one, t.eps_T_one,
    t.w_val, t.winv_val]
  have h1 := t.c_mul_cinv
  have h2 := t.d_mul_dinv
  have e : t.d * ((t.a : ℤ) + 2 * t.b) + (t.c : ℤ) ^ 2 + t.d ^ 2 = 3 * (t.a : ℤ) ^ 2 := by
    have h : (t.c : ℤ) ^ 2 = (t.a : ℤ) ^ 2 + t.a * t.b + t.b ^ 2 := by exact_mod_cast t.norm
    unfold d; rw [h]; ring
  have e' := congrArg (fun z : ℤ => (z : ZMod t.n)) e
  push_cast at e' ⊢
  linear_combination e' + (t.c : ZMod t.n) ^ 2 * h2 + (t.d : ZMod t.n) ^ 2 * h1

/-- **Row-I evaluation criterion.** `ε(B_I(k)) = 0` in `ZMod (3ab)` if and only if `b ∣ k`. -/
theorem eps_rowIBoundary_eq_zero_iff (k : ℤ) : t.eps (t.rowIBoundary k) = 0 ↔ (t.b : ℤ) ∣ k := by
  have hd : IsUnit (t.d : ZMod t.n) := by rw [← t.dU_val]; exact t.dU.isUnit
  unfold rowIBoundary
  rw [map_mul, t.eps_C]
  constructor
  · intro h
    have h' : (k : ZMod t.n) * (3 * (t.a : ZMod t.n) ^ 2) = 0 := by
      rw [← t.d_mul_eps_rowI, mul_left_comm, h, mul_zero]
    have h'' : ((k * (3 * (t.a : ℤ) ^ 2) : ℤ) : ZMod t.n) = 0 := by push_cast; exact h'
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h''
    unfold n at h''
    push_cast at h''
    -- 3ab ∣ 3a^2 k gives b ∣ a k, and gcd(a, b) = 1
    have ha : (0 : ℤ) < 3 * t.a := by have := t.ha; positivity
    have h3 : (3 * (t.a : ℤ)) * t.b ∣ (3 * t.a) * (t.a * k) := by
      have : k * (3 * (t.a : ℤ) ^ 2) = (3 * t.a) * (t.a * k) := by ring
      rw [← this]; exact h''
    have h4 : (t.b : ℤ) ∣ t.a * k := (mul_dvd_mul_iff_left ha.ne').mp h3
    have hcop : IsCoprime (t.b : ℤ) (t.a : ℤ) :=
      Nat.isCoprime_iff_coprime.mpr t.coprime_ab.symm
    exact hcop.dvd_of_dvd_mul_left h4
  · rintro ⟨m, rfl⟩
    -- ε(B) = b m · (...), and d · (...) = 3 a^2, so d · ε(B) = 3 a^2 b m = 0
    have hz : (t.d : ZMod t.n) * ((((t.b : ℤ) * m : ℤ) : ZMod t.n) * t.eps (C ((t.a : ℤ) + 2 * t.b)
        - C (t.c : ℤ) * T (-1) - C (t.c : ℤ) * T 1)) = 0 := by
      rw [mul_left_comm, t.d_mul_eps_rowI]
      have : (((t.b : ℤ) * m : ℤ) : ZMod t.n) * (3 * (t.a : ZMod t.n) ^ 2)
          = ((t.n : ℕ) : ZMod t.n) * ((t.a : ZMod t.n) * m) := by
        unfold n; push_cast; ring
      rw [this, t.n_eq_zero, zero_mul]
    exact (hd.mul_right_eq_zero).mp hz

/-- From the geometric premise `B_I(k) ∈ I`, the integer scale satisfies `b ∣ k`. -/
theorem b_dvd_of_rowIBoundary_mem {k : ℤ} (h : t.rowIBoundary k ∈ t.ideal) : (t.b : ℤ) ∣ k :=
  (t.eps_rowIBoundary_eq_zero_iff k).mp (t.eps_kills_ideal h)

/-- **Lemma `lem:rowI`(a), arithmetic content, integer scale.** If the row-I target has
integer scale `k`, count `N * b = k^2 (a + 2b)`, and its boundary value lies in `I`
(geometric premise), then `N` is not prime. -/
theorem rowI_not_prime {k N : ℕ} (hN : N * t.b = k ^ 2 * (t.a + 2 * t.b))
    (hprem : t.RowIPremise k) : ¬ N.Prime := by
  have h := t.b_dvd_of_rowIBoundary_mem hprem
  exact t.rowI_not_prime_of_dvd (by exact_mod_cast h) hN

/-- **Lemma `lem:rowI`(a), arithmetic content, rational scale.** Let the target sides be
`k (c, c, a+2b)` with `k > 0` rational, let them be integers (boundary integrality), let the count
be `N * b = k^2 (a + 2b)`, and assume the geometric premise for the (integer) scale. Then `N` is not
prime. -/
theorem rowI_not_prime_rat {k : ℚ} (hk : 0 < k) (hs : SidesIntegral k t.c t.c (t.a + 2 * t.b))
    {N : ℕ} (hN : (N : ℚ) * t.b = k ^ 2 * (t.a + 2 * t.b))
    (hprem : ∀ n : ℕ, (n : ℚ) = k → t.RowIPremise n) : ¬ N.Prime := by
  obtain ⟨n, -, rfl⟩ := scale_nat_of_primitive3 t.rowI_primitive hk hs
  have hN' : N * t.b = n ^ 2 * (t.a + 2 * t.b) := by exact_mod_cast hN
  exact t.rowI_not_prime hN' (hprem n rfl)

/-- The relabeled row I: target `(β, β, π - 2β)` with sides `k (c, c, 2a + b)` and count
`N * a = k^2 (2a + b)`; the premise is the row-I premise of the swapped triple. -/
theorem rowI_swap_not_prime {k N : ℕ} (hN : N * t.a = k ^ 2 * (2 * t.a + t.b))
    (hprem : t.swap.RowIPremise k) : ¬ N.Prime := by
  have hN' : N * t.swap.b = k ^ 2 * (t.swap.a + 2 * t.swap.b) := by
    simp only [swap_a, swap_b]; rw [hN]; ring
  exact t.swap.rowI_not_prime hN' hprem

/-! ### Row E (equilateral target) -/

/-- The equilateral target boundary value `± 3L z^e` (proof of Lemma `lem:rowI`(b);
progress634 App. `app:rowalgebra`, row E). -/
noncomputable def rowEBoundary (L : ℕ) (e : ℤ) : ℤ[T;T⁻¹] := C (3 * (L : ℤ)) * T e

/-- **Geometric premise (not formalized)** for the equilateral target of side `L`: its boundary
value lies in `I`, for some exponent `e` and sign. -/
def RowEPremise (L : ℕ) : Prop :=
  ∃ e : ℤ, rowEBoundary L e ∈ t.ideal ∨ -(rowEBoundary L e) ∈ t.ideal

/-- `ε(3L z^e) = 0` forces `ab ∣ L`. -/
theorem ab_dvd_of_rowE {L : ℕ} (h : t.RowEPremise L) : t.a * t.b ∣ L := by
  obtain ⟨e, he⟩ := h
  have h0 : t.eps (rowEBoundary L e) = 0 := by
    rcases he with he | he
    · exact t.eps_kills_ideal he
    · have := t.eps_kills_ideal he
      rw [RingHom.mem_ker, map_neg, neg_eq_zero] at this; exact this
  unfold rowEBoundary at h0
  rw [map_mul, t.eps_C] at h0
  have hT : IsUnit (t.eps (T e)) := by
    simp only [eps, eval₂_T]; exact Units.isUnit _
  have h1 : ((3 * (L : ℤ) : ℤ) : ZMod t.n) = 0 := hT.mul_left_eq_zero.mp h0
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h1
  unfold n at h1; push_cast at h1
  have h3 : (3 : ℤ) * (t.a * t.b) ∣ 3 * L := by rw [← mul_assoc]; exact h1
  have h4 : ((t.a * t.b : ℕ) : ℤ) ∣ (L : ℤ) := by
    push_cast; exact (mul_dvd_mul_iff_left (by norm_num : (3 : ℤ) ≠ 0)).mp h3
  exact_mod_cast h4

/-- **Row E.** An equilateral target of side `L` tiled by `N` tiles with `N * ab = L^2` (area) and
boundary value in `I` (geometric premise) has `N = ab m^2`, not prime (as `a, b ≥ 2`). -/
theorem rowE_not_prime {L N : ℕ} (hN : N * (t.a * t.b) = L ^ 2) (hprem : t.RowEPremise L) :
    ¬ N.Prime := by
  obtain ⟨m, rfl⟩ := t.ab_dvd_of_rowE hprem
  have ha := t.two_le_a; have hb := t.two_le_b
  have hN' : N = t.a * (t.b * m ^ 2) := by
    apply Nat.eq_of_mul_eq_mul_right (show 0 < t.a * t.b by positivity)
    rw [hN]; ring
  intro hp
  rw [hN'] at hp
  rcases Nat.eq_zero_or_pos m with h0 | h0
  · rw [h0] at hp; simp at hp; exact Nat.not_prime_zero hp
  · have : 1 ≤ m ^ 2 := Nat.one_le_pow _ _ h0
    exact Nat.not_prime_mul (by omega) (by nlinarith) hp

end G2Triple

end No19Tiling

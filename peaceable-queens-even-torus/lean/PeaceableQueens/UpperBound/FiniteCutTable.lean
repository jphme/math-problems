def domainRows (q : Nat) : Fin 5 → Row 8 := ![
  { coeff := ![1, -1, 0, 0, 0, 0, 0, 0], rhs := 0 },
  { coeff := ![0, 0, 1, -1, 0, 0, 0, 0], rhs := 0 },
  { coeff := ![1, 1, -1, -1, 0, 0, 0, 0], rhs := 0 },
  { coeff := ![0, 0, 0, 0, 1, 1, -1, -1], rhs := 0 },
  { coeff := ![1, 1, 1, 1, 1, 1, 1, 1], rhs := 4 * q }
]

def Canonical (q : Nat) (x : Point 8) : Prop :=
  ∀ row, (domainRows q row).Satisfied x

lemma canonical_rows (q : Nat) :
    ∀ x, Canonical q x → ∀ row, (domainRows q row).Satisfied x := by
  exact fun _ h => h

